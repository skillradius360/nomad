// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(uuid())
  email String? @unique
  name  String?
  phone String? @unique

  googleUid String?   @unique
  loginType LoginType @default(GOOGLE)
  role      UserRole?
  otp       Int?

  latitude  Float?
  longitude Float?
  address   String?

  shops     Shop[]
  orders    Order[]
  recharges Recharges[]

  profileImg String?

  billingPlan Plans   @default(TRIAL)
  isVerified  Boolean @default(false)
  isBlocked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Shop {
  id             String     @id @default(uuid())
  shopName       String
  ownerId        String
  shopImage      String?
  Address        String?
  Tags           String?
  Description    String?
  OpeningTime    DateTime?
  ClosingTime    DateTime?
  ShopOpenStatus ShopStatus @default(OPEN)
  Holidays       String[]   @default(["sunday"])
  Verified       Boolean    @default(false)
  shopBalance    Int        @default(100)
  shopCategory   ShopTypes

  MinimumDeliveryRate Int? @default(50)
  FreeDeliveryRate    Int? @default(70)

  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders    Order[]
  recharges Recharges[]
  combos    Combo[]

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Order {
  id                 String       @id @default(uuid())
  userId             String
  shopId             String?
  currentOrderStatus OrderStatus?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  // orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

