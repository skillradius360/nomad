// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(uuid())
  email String? @unique
  name  String?
  phone String? @unique

  googleUid String?   @unique
  loginType LoginType @default(GOOGLE)
  role      UserRole?
  otp       Int?

  latitude  Float?
  longitude Float?
  address   String?

  shops           Shop[]
  orders          Order[]
  recharges       Recharges[]
  completedOffers BuyerCompletedOffer[]

  profileImg String?
  buyerAdTargets BuyerAdTarget[]

  billingPlan Plans   @default(TRIAL)
  isVerified  Boolean @default(false)
  isBlocked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Shop {
  id             String            @id @default(uuid())
  shopName       String
  ownerId        String
  shopImage      String?
  Address        String?
  Tags           String?
  Description    String?
  OpeningTime    DateTime?
  ClosingTime    DateTime?
  ShopOpenStatus ShopStatus        @default(OPEN)
  status         ShopStatus        @default(AUTOMATIC)
  Holidays       String[]          @default(["sunday"])
  Verified       Boolean           @default(false)
  shopBalance    Int               @default(100)
  shopCategory   ShopTypes
  billingStatus  ShopBillingStatus @default(TRIAL)
  trialStartedAt DateTime          @default(now())
  trialDays      Int?
  trialEndsAt    DateTime?
  slug           String            @unique

  MinimumDeliveryRate Int? @default(50)
  FreeDeliveryRate    Int? @default(70)

  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders          Order[]
  recharges       Recharges[]
  combos          Combo[]
  items           ShopItem[]
  menus           Menu[]
  timings         ShopTiming[]
  completedOffers BuyerCompletedOffer[]
  targetedAds     AdSellerTarget[]

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShopTiming {
  id        String    @id @default(uuid())
  shopId    String
  dayOfWeek DayOfWeek

  /// Minutes after midnight in the shop's local timezone.
  /// Example: 9:30 AM = 570, 5:00 PM = 1020.
  startMinute Int
  endMinute   Int

  active Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, dayOfWeek])
  @@index([shopId, dayOfWeek, active])
}

model Order {
  id                 String        @id @default(uuid())
  userId             String
  shopId             String?
  currentOrderStatus OrderStatus   @default(NEW)
  paymentMethod      PaymentMethod @default(CASH)
  paymentReceived    Boolean       @default(false)
  subtotalAmount     Int           @default(0)
  deliveryAmount     Int           @default(0)
  totalAmount        Int           @default(0)
  customerNote       String?

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop           Shop?                @relation(fields: [shopId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  completedOffer BuyerCompletedOffer?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, currentOrderStatus])
  @@index([userId, createdAt])
}

model BuyerCompletedOffer {
  id          String   @id @default(uuid())
  buyerId     String
  shopId      String
  orderId     String   @unique
  totalAmount Int      @default(0)
  completedAt DateTime @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([buyerId, completedAt])
  @@index([shopId, completedAt])
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String
  orderItemType    OrderItemType
  shopItemId       String?
  comboId          String?
  name             String
  quantity         Int           @default(1)
  priceAtOrderTime Int           @default(0)
  totalPrice       Int           @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopItem ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  combo    Combo?    @relation(fields: [comboId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([shopItemId])
  @@index([comboId])
}

model OTP {
  id Int @id @default(autoincrement())

  phone String?
  code  String?

  verified  Boolean  @default(false)
  expiresAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model Recharges {
  id          String         @id @default(uuid())
  userId      String
  shopId      String
  orderAmount Int
  status      RechargeStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Ad {
  id                      String       @id @default(uuid())
  name                    String
  description             String?
  imageUrl                String?
  sellerDashboardImageUrl String?
  sellerHomeImageUrl      String?
  buyerExploreImageUrl    String?
  buyerShopPageImageUrl   String?
  linkUrl                 String?
  placement               AdPlacement?
  targetMode              AdTargetMode @default(ALL_SELLERS)
  startsAt                DateTime     @default(now())
  endsAt                  DateTime
  active                  Boolean      @default(true)

  sellerTargets AdSellerTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([placement, active, startsAt, endsAt])
}

model AdSellerTarget {
  id     String @id @default(uuid())
  adId   String
  shopId String

  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([adId, shopId])
  @@index([shopId])
}

model BuyerAds {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  target      AdTarget @default(GLOBAL)
  startsAt    DateTime @default(now())
  endsAt      DateTime

  buyerTargets BuyerAdTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active, target, startsAt, endsAt])
}

model BuyerAdTarget {
  id        String @id @default(uuid())
  buyerAdId String
  buyerId   String

  buyerAd BuyerAds @relation(fields: [buyerAdId], references: [id], onDelete: Cascade)
  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([buyerAdId, buyerId])
  @@index([buyerId])
}

enum AdTarget {
  GLOBAL
  INDIVIDUAL
}

model Cuisine {
  id          String  @id @default(uuid())
  sortOrderId Int
  name        String
  slug        String  @unique
  active      Boolean @default(true)

  categories Categories[]
  combos     Combo[]
}

model Categories {
  id          String  @id @default(uuid())
  sortOrderId Int?
  name        String
  slug        String  @unique
  allItems    Items[]

  cuisineId String?
  cuisine   Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)

  combos Combo[]
}

model Items {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  sortOrderId Int?
  categoryId  String?
  category    Categories? @relation(fields: [categoryId], references: [id])

  shopItems ShopItem[]
  tags      ItemTag[]
  active    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShopItem {
  id     String @id @default(uuid())
  shopId String
  itemId String

  pricing            String
  discount           Int?   @default(0)
  discountPercentage Float? @default(0.0)
  availableQuantity  Int?   @default(0)

  imageUrl    String?
  description String?
  sortOrderId Int?
  active      Boolean @default(true)

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item Items @relation(fields: [itemId], references: [id], onDelete: Cascade)

  comboItems ComboItem[]
  menuItems  MenuItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, itemId])
}

model Combo {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  comboKey    String?
  description String?
  imageUrl    String?

  totalPrice         Int
  discount           Int   @default(0)
  finalPrice         Int?
  percentageDiscount Float @default(0.0)

  cuisineId  String?
  categoryId String?

  active            Boolean @default(true)
  availableQuantity Int?    @default(0)
  sortOrderId       Int?

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cuisine  Cuisine?    @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items      ComboItem[]
  menuCombos MenuCombo[]
  orderItems OrderItem[]
  tags       ComboTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, comboKey])
}

model Tag {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  active Boolean @default(true)

  itemTags  ItemTag[]
  comboTags ComboTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ItemTag {
  id     String @id @default(uuid())
  itemId String
  tagId  String

  item Items @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([itemId, tagId])
  @@index([tagId])
}

model ComboTag {
  id      String @id @default(uuid())
  comboId String
  tagId   String

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([comboId, tagId])
  @@index([tagId])
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemId   String
  quantity Int    @default(1)

  combo Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item  ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([comboId, itemId])
}

model Menu {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  description String?
  active      Boolean @default(true)
  sortOrderId Int?

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  schedules MenuSchedule[]
  items     MenuItem[]
  combos    MenuCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, name])
}

model MenuSchedule {
  id        String    @id @default(uuid())
  menuId    String
  dayOfWeek DayOfWeek

  /// Minutes after midnight in the shop's local timezone.
  /// Example: 9:30 AM = 570, 5:00 PM = 1020.
  startMinute Int
  endMinute   Int

  active Boolean @default(true)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([menuId, dayOfWeek, active])
}

model MenuItem {
  id     String @id @default(uuid())
  menuId String
  itemId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, itemId])
}

model MenuCombo {
  id      String @id @default(uuid())
  menuId  String
  comboId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, comboId])
}

enum UserRole {
  SUPER
  BUYER
  SELLER
  ADMIN
}

enum LoginType {
  GOOGLE
  OTP
  CODE
}

enum Plans {
  TRIAL
  ACTIVE
}

enum ShopBillingStatus {
  TRIAL
  ACTIVE
  PAYMENT_DUE
}

enum ShopStatus {
  OPEN
  CLOSED
  AUTOMATIC
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopTypes {
  FASTFOOD
  VEGETABLES
}

enum AdPlacement {
  SELLER_DASHBOARD
  SELLER_HOME
  BUYER_EXPLORE
  BUYER_SHOP_PAGE
}

enum AdTargetMode {
  ALL_SELLERS
  TARGETED_SELLERS
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum OrderItemType {
  ITEM
  COMBO
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
