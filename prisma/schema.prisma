// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(uuid())
  email String? @unique
  name  String?
  phone String? @unique

  googleUid String?   @unique
  loginType LoginType @default(GOOGLE)
  role      UserRole?
  otp       Int?

  latitude  Float?
  longitude Float?
  address   String?

  shops     Shop[]
  orders    Order[]
  recharges Recharges[]

  profileImg String?

  billingPlan Plans   @default(TRIAL)
  isVerified  Boolean @default(false)
  isBlocked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Shop {
  id             String     @id @default(uuid())
  shopName       String
  ownerId        String
  shopImage      String?
  Address        String?
  Tags           String?
  Description    String?
  OpeningTime    DateTime?
  ClosingTime    DateTime?
  ShopOpenStatus ShopStatus @default(OPEN)
  Holidays       String[]   @default(["sunday"])
  Verified       Boolean    @default(false)
  shopBalance    Int        @default(100)
  shopCategory   ShopTypes

  MinimumDeliveryRate Int? @default(50)
  FreeDeliveryRate    Int? @default(70)

  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  orders    Order[]
  recharges Recharges[]
  combos    Combo[]
  items     ShopItem[]
  menus     Menu[]

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Order {
  id                 String        @id @default(uuid())
  userId             String
  shopId             String?
  currentOrderStatus OrderStatus   @default(NEW)
  paymentMethod      PaymentMethod @default(CASH)
  paymentReceived    Boolean       @default(false)
  subtotalAmount     Int           @default(0)
  deliveryAmount     Int           @default(0)
  totalAmount        Int           @default(0)
  customerNote       String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop       Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, currentOrderStatus])
  @@index([userId, createdAt])
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String
  orderItemType    OrderItemType
  shopItemId       String?
  comboId          String?
  name             String
  quantity         Int           @default(1)
  priceAtOrderTime Int           @default(0)
  totalPrice       Int           @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopItem ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  combo    Combo?    @relation(fields: [comboId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([shopItemId])
  @@index([comboId])
}

model OTP {
  id Int @id @default(autoincrement())

  phone String?
  code  String?

  verified  Boolean  @default(false)
  expiresAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model Recharges {
  id          String         @id @default(uuid())
  userId      String
  shopId      String
  orderAmount Int
  status      RechargeStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Cuisine {
  id          String  @id @default(uuid())
  sortOrderId Int
  name        String
  slug        String  @unique
  active      Boolean @default(true)

  categories Categories[]
  combos     Combo[]
}

model Categories {
  id          String  @id @default(uuid())
  sortOrderId Int?
  name        String
  slug        String  @unique
  allItems    Items[]

  cuisineId String?
  cuisine   Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)

  combos Combo[]
}

model Items {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  sortOrderId Int?
  categoryId  String?
  category    Categories? @relation(fields: [categoryId], references: [id])

  shopItems ShopItem[]
  active    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShopItem {
  id     String @id @default(uuid())
  shopId String
  itemId String

  pricing            String
  discount           Int?   @default(0)
  discountPercentage Float? @default(0.0)
  availableQuantity  Int?   @default(0)

  imageUrl     String?
  description  String?
  sortOrderId  Int?
  active       Boolean @default(true)

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item Items @relation(fields: [itemId], references: [id], onDelete: Cascade)

  comboItems ComboItem[]
  menuItems  MenuItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, itemId])
}

model Combo {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  comboKey    String?
  description String?
  imageUrl    String?

  totalPrice         Int
  discount           Int   @default(0)
  finalPrice         Int?
  percentageDiscount Float @default(0.0)

  cuisineId  String?
  categoryId String?

  active            Boolean @default(true)
  availableQuantity Int?    @default(0)
  sortOrderId       Int?

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cuisine  Cuisine?    @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items      ComboItem[]
  menuCombos MenuCombo[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, comboKey])
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemId   String
  quantity Int    @default(1)

  combo Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item  ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([comboId, itemId])
}

model Menu {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  description String?
  active      Boolean @default(true)
  sortOrderId Int?

  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  schedules MenuSchedule[]
  items     MenuItem[]
  combos    MenuCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, name])
}

model MenuSchedule {
  id        String    @id @default(uuid())
  menuId    String
  dayOfWeek DayOfWeek

  /// Minutes after midnight in the shop's local timezone.
  /// Example: 9:30 AM = 570, 5:00 PM = 1020.
  startMinute Int
  endMinute   Int

  active Boolean @default(true)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([menuId, dayOfWeek, active])
}

model MenuItem {
  id     String @id @default(uuid())
  menuId String
  itemId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, itemId])
}

model MenuCombo {
  id      String @id @default(uuid())
  menuId  String
  comboId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, comboId])
}

enum UserRole {
  SUPER
  BUYER
  SELLER
  ADMIN
}

enum LoginType {
  GOOGLE
  OTP
  CODE
}

enum Plans {
  TRIAL
  ACTIVE
}

enum ShopStatus {
  OPEN
  CLOSED
  AUTOMATIC
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopTypes {
  FASTFOOD
  VEGETABLES
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum OrderItemType {
  ITEM
  COMBO
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
