// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(uuid())
  email String? @unique
  name  String?
  phone String? @unique

  googleUid String?   @unique
  loginType LoginType @default(GOOGLE)
  role      UserRole?
  otp       Int?

  latitude  Float?
  longitude Float?
  address   String?

  shops           Shop[]
  orders          Order[]
  recharges       Recharges[]
  completedOffers BuyerCompletedOffer[]
  targetedOffers  OfferBuyer[]

  profileImg     String?
  buyerAdTargets BuyerAdTarget[]
  createdBanners Banner[]

  billingPlan Plans   @default(TRIAL)
  isVerified  Boolean @default(false)
  isBlocked   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Shop {
  id             String            @id @default(uuid())
  shopName       String
  ownerId        String
  shopImage      String?
  Address        String?
  Tags           String?
  Description    String?
  OpeningTime    DateTime?
  ClosingTime    DateTime?
  ShopOpenStatus ShopStatus        @default(OPEN)
  status         ShopStatus        @default(AUTOMATIC)
  Holidays       String[]          @default(["sunday"])
  Verified       Boolean           @default(false)
  shopBalance    Int               @default(0)
  totalSlots     Int               @default(0)
  usedSlots      Int               @default(0)
  shopTypeId     String?
  billingStatus  ShopBillingStatus @default(TRIAL)
  trialStartedAt DateTime          @default(now())
  trialDays      Int?
  trialEndsAt    DateTime?
  slug           String            @unique

  MinimumDeliveryRate Int? @default(50)
  FreeDeliveryRate    Int? @default(70)

  owner            User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shopType         ShopType?               @relation(fields: [shopTypeId], references: [id], onDelete: SetNull)
  orders           Order[]
  recharges        Recharges[]
  combos           Combo[]
  items            ShopItem[]
  menus            Menu[]
  timings          ShopTiming[]
  completedOffers  BuyerCompletedOffer[]
  targetedAds      AdSellerTarget[]
  offers           Offer[]
  revenueSummaries ShopRevenueSummary[]
  banners          Banner[]
  featureOverrides ShopFeatureOverride[]
  dailyBillings    ShopDailyBilling[]
  billingLedger    ShopBillingLedger[]
  orderCommissions OrderCommissionCharge[]

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopTypeId])
}

model ShopType {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  active      Boolean @default(true)

  features ShopTypeFeature[]
  shops    Shop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShopTypeFeature {
  id         String         @id @default(uuid())
  shopTypeId String
  feature    ShopFeatureKey
  enabled    Boolean        @default(true)

  shopType ShopType @relation(fields: [shopTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopTypeId, feature])
  @@index([feature, enabled])
}

model ShopFeatureOverride {
  id      String         @id @default(uuid())
  shopId  String
  feature ShopFeatureKey
  enabled Boolean        @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, feature])
  @@index([shopId, enabled])
  @@index([feature, enabled])
}

model ShopTiming {
  id        String    @id @default(uuid())
  shopId    String
  dayOfWeek DayOfWeek

  /// Minutes after midnight in the shop's local timezone.
  /// Example: 9:30 AM = 570, 5:00 PM = 1020.
  startMinute Int
  endMinute   Int

  active Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, dayOfWeek])
  @@index([shopId, dayOfWeek, active])
}

model Order {
  id                     String        @id @default(uuid())
  userId                 String
  shopId                 String?
  currentOrderStatus     OrderStatus   @default(NEW)
  paymentMethod          PaymentMethod @default(CASH)
  paymentReceived        Boolean       @default(false)
  subtotalAmount         Int           @default(0)
  discountAmount         Int           @default(0)
  deliveryAmount         Int           @default(0)
  deliveryDiscountAmount Int           @default(0)
  totalAmount            Int           @default(0)
  paidAmount             Int           @default(0)
  refundAmount           Int           @default(0)
  customerNote           String?
  completedAt            DateTime?
  cancelledAt            DateTime?
  refundedAt             DateTime?

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop             Shop?                  @relation(fields: [shopId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  completedOffer   BuyerCompletedOffer?
  commissionCharge OrderCommissionCharge?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, currentOrderStatus])
  @@index([userId, createdAt])
}

model BuyerCompletedOffer {
  id          String   @id @default(uuid())
  buyerId     String
  shopId      String
  orderId     String   @unique
  totalAmount Int      @default(0)
  completedAt DateTime @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([buyerId, completedAt])
  @@index([shopId, completedAt])
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String
  orderItemType    OrderItemType
  shopItemId       String?
  comboId          String?
  name             String
  quantity         Int           @default(1)
  priceAtOrderTime Int           @default(0)
  totalPrice       Int           @default(0)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopItem ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  combo    Combo?    @relation(fields: [comboId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([shopItemId])
  @@index([comboId])
}

model OTP {
  id Int @id @default(autoincrement())

  phone String?
  code  String?

  verified  Boolean  @default(false)
  expiresAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model Recharges {
  id                       String         @id @default(uuid())
  userId                   String
  shopId                   String
  orderAmount              Int
  requestedSlots           Int            @default(0)
  requestedDays            Int?
  slotPriceSnapshot        Int            @default(0)
  commissionBpsSnapshot    Int            @default(0)
  estimatedDailyCommission Int            @default(0)
  paymentTransferDone      Boolean        @default(false)
  paymentReference         String?
  status                   RechargeStatus @default(PENDING)
  approvedAt               DateTime?
  rejectedAt               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BillingSettings {
  id                  String   @id @default("default")
  dailySlotPrice      Int      @default(0)
  commissionBps       Int      @default(0)
  estimationBufferBps Int      @default(0)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model RechargeDayOption {
  id        String   @id @default(uuid())
  days      Int      @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model RechargeAmountOption {
  id        String   @id @default(uuid())
  amount    Int      @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model OrderCommissionCharge {
  id                 String           @id @default(uuid())
  orderId            String           @unique
  shopId             String
  orderValue         Int
  commissionBps      Int
  commissionAmount   Int
  refundedCommission Int              @default(0)
  pendingAdjustment  Int              @default(0)
  status             CommissionStatus @default(PENDING)
  completedAt        DateTime
  settledAt          DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, status, completedAt])
  @@index([shopId, pendingAdjustment])
}

model ShopDailyBilling {
  id                         String   @id @default(uuid())
  shopId                     String
  billingDate                DateTime
  totalSlots                 Int
  dailySlotPrice             Int
  slotCharge                 Int
  completedOrderValue        Int      @default(0)
  commissionBps              Int
  commissionCharge           Int      @default(0)
  commissionRefundAdjustment Int      @default(0)
  totalCharge                Int
  openingBalance             Int
  closingBalance             Int

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, billingDate])
  @@index([billingDate])
}

model ShopBillingLedger {
  id           String                @id @default(uuid())
  shopId       String
  entryType    ShopBillingLedgerType
  amount       Int
  balanceAfter Int
  referenceKey String                @unique
  description  String?
  occurredAt   DateTime              @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shopId, occurredAt])
}

model CompanyRevenueDaily {
  id                          String   @id @default(uuid())
  revenueDate                 DateTime @unique
  slotRevenue                 Int      @default(0)
  orderCommissionRevenue      Int      @default(0)
  commissionRefundAdjustments Int      @default(0)
  totalRevenue                Int      @default(0)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @default(now()) @updatedAt
}

model Ad {
  id                      String       @id @default(uuid())
  name                    String
  description             String?
  imageUrl                String?
  sellerDashboardImageUrl String?
  sellerHomeImageUrl      String?
  buyerExploreImageUrl    String?
  buyerShopPageImageUrl   String?
  linkUrl                 String?
  placement               AdPlacement?
  targetMode              AdTargetMode @default(ALL_SELLERS)
  startsAt                DateTime     @default(now())
  endsAt                  DateTime
  active                  Boolean      @default(true)

  sellerTargets AdSellerTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([placement, active, startsAt, endsAt])
}

model AdSellerTarget {
  id     String @id @default(uuid())
  adId   String
  shopId String

  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([adId, shopId])
  @@index([shopId])
}

model Banner {
  id          String  @id @default(uuid())
  shopId      String
  createdById String
  text        String
  imageUrl    String
  active      Boolean @default(false)

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, active, createdAt])
  @@index([createdById])
}

model BuyerAds {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  target      AdTarget @default(GLOBAL)
  startsAt    DateTime @default(now())
  endsAt      DateTime

  buyerTargets BuyerAdTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([active, target, startsAt, endsAt])
}

model BuyerAdTarget {
  id        String @id @default(uuid())
  buyerAdId String
  buyerId   String

  buyerAd BuyerAds @relation(fields: [buyerAdId], references: [id], onDelete: Cascade)
  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([buyerAdId, buyerId])
  @@index([buyerId])
}

enum AdTarget {
  GLOBAL
  INDIVIDUAL
}

model Cuisine {
  id          String  @id @default(uuid())
  sortOrderId Int
  name        String
  slug        String  @unique
  active      Boolean @default(true)

  categories Categories[]
  combos     Combo[]
}

model Categories {
  id          String  @id @default(uuid())
  sortOrderId Int?
  name        String
  slug        String  @unique
  allItems    Items[]

  cuisineId String?
  cuisine   Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)

  combos Combo[]
}

model Items {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  sortOrderId Int?
  categoryId  String?
  category    Categories? @relation(fields: [categoryId], references: [id])

  shopItems ShopItem[]
  tags      ItemTag[]
  active    Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ShopItem {
  id     String @id @default(uuid())
  shopId String
  itemId String

  pricing           String
  availableQuantity Int?   @default(0)

  imageUrl    String?
  description String?
  sortOrderId Int?
  active      Boolean @default(true)

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  item Items @relation(fields: [itemId], references: [id], onDelete: Cascade)

  comboItems ComboItem[]
  menuItems  MenuItem[]
  orderItems OrderItem[]
  offerItems OfferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, itemId])
}

model Combo {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  comboKey    String?
  description String?
  imageUrl    String?

  totalPrice Int

  cuisineId  String?
  categoryId String?

  active            Boolean @default(true)
  availableQuantity Int?    @default(0)
  sortOrderId       Int?

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cuisine  Cuisine?    @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items       ComboItem[]
  menuCombos  MenuCombo[]
  orderItems  OrderItem[]
  tags        ComboTag[]
  offerCombos OfferCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, comboKey])
}

model Tag {
  id     String  @id @default(uuid())
  name   String
  slug   String  @unique
  active Boolean @default(true)

  itemTags          ItemTag[]
  comboTags         ComboTag[]
  offerAudienceTags OfferAudienceTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ItemTag {
  id     String @id @default(uuid())
  itemId String
  tagId  String

  item Items @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([itemId, tagId])
  @@index([tagId])
}

model ComboTag {
  id      String @id @default(uuid())
  comboId String
  tagId   String

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([comboId, tagId])
  @@index([tagId])
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemId   String
  quantity Int    @default(1)

  combo Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item  ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([comboId, itemId])
}

model Menu {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  description String?
  active      Boolean @default(true)
  sortOrderId Int?

  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  schedules  MenuSchedule[]
  items      MenuItem[]
  combos     MenuCombo[]
  offerMenus OfferMenu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, name])
}

model MenuSchedule {
  id        String    @id @default(uuid())
  menuId    String
  dayOfWeek DayOfWeek

  /// Minutes after midnight in the shop's local timezone.
  /// Example: 9:30 AM = 570, 5:00 PM = 1020.
  startMinute Int
  endMinute   Int

  active Boolean @default(true)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([menuId, dayOfWeek, active])
}

model MenuItem {
  id     String @id @default(uuid())
  menuId String
  itemId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, itemId])
}

model MenuCombo {
  id      String @id @default(uuid())
  menuId  String
  comboId String

  active      Boolean @default(true)
  sortOrderId Int?

  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([menuId, comboId])
}

model Offer {
  id          String    @id @default(uuid())
  shopId      String
  title       String
  description String?
  offerType   OfferType
  active      Boolean   @default(true)
  startsAt    DateTime
  endsAt      DateTime

  menuScope    OfferMenuScope    @default(ALL_MENUS)
  applyTo      OfferApplyTo
  audienceType OfferAudienceType @default(ALL_BUYERS)
  stackingMode OfferStackingMode @default(EXCLUSIVE)

  minQuantity       Int?
  minOrderAmount    Int?
  discountType      OfferDiscountType?
  discountValue     Float?
  maxDiscountAmount Int?
  rewardQuantity    Int?
  imageUrl          String?

  shop   Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  menus  OfferMenu[]
  items  OfferItem[]
  combos OfferCombo[]
  buyers OfferBuyer[]
  tags   OfferAudienceTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, active, startsAt, endsAt])
  @@index([audienceType])
}

model OfferMenu {
  id      String @id @default(uuid())
  offerId String
  menuId  String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, menuId])
  @@index([menuId])
}

model OfferItem {
  id         String             @id @default(uuid())
  offerId    String
  shopItemId String
  role       OfferSelectionRole @default(APPLIES_TO)

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shopItem ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, shopItemId, role])
  @@index([shopItemId])
}

model OfferCombo {
  id      String             @id @default(uuid())
  offerId String
  comboId String
  role    OfferSelectionRole @default(APPLIES_TO)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, comboId, role])
  @@index([comboId])
}

model OfferBuyer {
  id      String @id @default(uuid())
  offerId String
  buyerId String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, buyerId])
  @@index([buyerId])
}

model OfferAudienceTag {
  id      String @id @default(uuid())
  offerId String
  tagId   String

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, tagId])
  @@index([tagId])
}

model ShopRevenueSummary {
  id         String            @id @default(uuid())
  shopId     String
  periodType RevenuePeriodType
  periodDate DateTime

  successfulOrders Int @default(0)
  cancelledOrders  Int @default(0)
  grossRevenue     Int @default(0)
  discountAmount   Int @default(0)
  deliveryRevenue  Int @default(0)
  refundAmount     Int @default(0)
  netRevenue       Int @default(0)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, periodType, periodDate])
  @@index([shopId, periodType, periodDate])
}

enum UserRole {
  SUPER
  BUYER
  SELLER
  ADMIN
}

enum LoginType {
  GOOGLE
  OTP
  CODE
}

enum Plans {
  TRIAL
  ACTIVE
}

enum ShopBillingStatus {
  TRIAL
  ACTIVE
  PAYMENT_DUE
  HOLD
}

enum ShopStatus {
  OPEN
  CLOSED
  AUTOMATIC
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  SETTLED
}

enum ShopBillingLedgerType {
  RECHARGE
  DAILY_CHARGE
  REFUND_ADJUSTMENT
  ADMIN_ADJUSTMENT
}

enum ShopFeatureKey {
  ITEMS
  CATEGORIES
  CUISINE
  MENUS
  COMBOS
}

enum AdPlacement {
  SELLER_DASHBOARD
  SELLER_HOME
  BUYER_EXPLORE
  BUYER_SHOP_PAGE
}

enum AdTargetMode {
  ALL_SELLERS
  TARGETED_SELLERS
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum OrderItemType {
  ITEM
  COMBO
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OfferType {
  BUY_X_GET_Y
  PERCENT_DISCOUNT
  FLAT_DISCOUNT
  FREE_DELIVERY
  COMBO_DISCOUNT
}

enum OfferMenuScope {
  ALL_MENUS
  SPECIFIC_MENUS
}

enum OfferApplyTo {
  ALL_CART
  SPECIFIC_ITEMS
  SPECIFIC_COMBOS
  ALL_ITEMS_IN_SELECTED_COMBOS
}

enum OfferAudienceType {
  ALL_BUYERS
  SPECIFIC_BUYERS
  TAG_BASED
  PREMIUM_CUSTOMERS
  NEW_CUSTOMERS
}

enum OfferStackingMode {
  EXCLUSIVE
  STACKABLE
}

enum OfferDiscountType {
  PERCENTAGE
  FLAT
  FREE
}

enum OfferSelectionRole {
  APPLIES_TO
  CUSTOMER_BUYS
