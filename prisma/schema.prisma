model OTP {
  id Int @id @default(autoincrement())

  phone String?
  code  String?

  verified  Boolean  @default(false)
  expiresAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model Recharges {
  id          String         @id @default(uuid())
  userId      String
  shopId      String
  orderAmount Int
  status      RechargeStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Cuisine {
  id          String  @id @default(uuid())
  sortOrderId Int
  name        String
  slug        String  @unique
  active      Boolean @default(true)

  categories Categories[]
  combos     Combo[]
}

model Categories {
  id          String  @id @default(uuid())
  sortOrderId Int?
  name        String
  slug        String  @unique
  allItems    Items[]

  cuisineId String?
  cuisine   Cuisine? @relation(fields: [cuisineId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)

  combos Combo[]
}

model Items {
  id   String @id @default(uuid())
  name String
  // photoUrl    String?

  // not implemented
  pricing            String
  discount           Int?   @default(0)
  discountPercentage Float? @default(0.0)
  availableQuantity  Int?   @default(0)

  sortOrderId Int?
  categoryId  String?
  category    Categories? @relation(fields: [categoryId], references: [id])
  // orderItems  OrderItem[]
  comboItems  ComboItem[]
  active      Boolean     @default(true)
}

model Combo {
  id          String  @id @default(uuid())
  shopId      String
  name        String
  comboKey    String?
  description String?
  imageUrl    String?

  totalPrice         Int
  discount           Int   @default(0)
  finalPrice         Int?
  percentageDiscount Float @default(0.0)

  cuisineId  String?
  categoryId String?

  active            Boolean @default(true)
  availableQuantity Int?    @default(0)
  sortOrderId       Int?

  shop     Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cuisine  Cuisine?    @relation(fields: [cuisineId], references: [id], onDelete: SetNull)
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  items ComboItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, comboKey])
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemId   String
  quantity Int    @default(1)

  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  item  Items @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([comboId, itemId])
}

enum UserRole {
  SUPER
  BUYER
  SELLER
  ADMIN
}

enum LoginType {
  GOOGLE
  OTP
  CODE
}

enum Plans {
  TRIAL
  ACTIVE
}

enum ShopStatus {
  OPEN
  CLOSED
  AUTOMATIC
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopTypes {
  FASTFOOD
  VEGETABLES
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  PAYMENT_DONE
  DONE
  ORDER_READY
}
